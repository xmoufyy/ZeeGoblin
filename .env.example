# ZeeGoblin configuration. Copy this file to .env and fill it in.
# NEVER commit .env or share it - DISCORD_TOKEN controls the bot.

# --- Required ---------------------------------------------------------------
# Developer Portal > your app > Bot > Reset Token
DISCORD_TOKEN=
# Right-click the server icon > Copy Server ID (enable Developer Mode first)
DISCORD_GUILD_ID=
# Zee's Discord user ID (right-click Zee > Copy User ID). Full control.
OWNER_USER_ID=
# Role IDs (Server Settings > Roles > right-click role > Copy Role ID)
HEAD_MOD_ROLE_ID=
MOD_ROLE_ID=
PAYMENT_MOD_ROLE_ID=

# --- Optional ---------------------------------------------------------------
# Private staff channel for roll-call summaries, flags and payment mismatches.
STAFF_CHANNEL_ID=

DATABASE_URL=sqlite+aiosqlite:///./data/zeegoblin.db

# Roll calls (minutes / SOL). Amounts are exact decimals, max 9 places.
DEFAULT_ROLLCALL_DURATION=3
MAX_ROLLCALL_DURATION=60
DEFAULT_ROLLCALL_REWARD=0.01
MAX_ROLLCALL_REWARD=0.10
# Hard cap per roll call; also used as the budget when /rollcall start gives none.
MAX_ROLLCALL_BUDGET=5.0
MAX_ROLLCALL_PARTICIPANTS=5000

# Largest single manual award (/tip add).
MAX_MANUAL_AWARD=1.0
# true = a different staff member must confirm a payment than the one who recorded it.
REQUIRE_SEPARATE_PAYMENT_CONFIRMER=false

# Let members type "present" / "here" in the roll-call channel as well as clicking.
# Requires the Message Content privileged intent in the Developer Portal.
ENABLE_MESSAGE_CHECKIN=false

# Register slash commands to DISCORD_GUILD_ID on startup.
SYNC_COMMANDS_ON_STARTUP=true

# Bot status: playing | watching | listening | competing | custom
# (custom = plain text with an emoji, e.g. BOT_ACTIVITY_TEXT=🎰 Gamble on Solpump)
# Discord does not allow images or buttons in a bot's status; use /solpump for that.
BOT_ACTIVITY_TYPE=playing
BOT_ACTIVITY_TEXT=Gambling on Solpump

# /solpump posts this link as a "Gamble On Solpump" button, with artwork from
# assets/solpump.png (or .jpg / .webp) if present.
SOLPUMP_URL=https://solpump.io/a/ZEEDUDE

LOG_LEVEL=INFO
